<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GramaYatri" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FFFF6F00</item>
    </style>

    <style name="Theme.GramaYatri.Launch" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#FF6F00</item>
        <item name="android:navigationBarColor">#FF6F00</item>
        <item name="android:windowBackground">#FFFF6F00</item>
    </style>

    <style name="Theme.GramaYatri.TicketMachine" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">#0B1A2B</item>
        <item name="android:navigationBarColor">#0B1A2B</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
