{
  "rules": {
    "routes": {
      ".read": true,
      ".write": false
    },
    "pings": {
      "$routeId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["timestamp"],
        "$pingId": {
          ".validate": "newData.hasChildren(['routeId','stopId','stopName','stopSequence','lat','lng','userName','deviceId','type','timestamp','isActive'])",
          "routeId": { ".validate": "newData.isString() && newData.val().length > 0" },
          "stopId": { ".validate": "newData.isString()" },
          "stopName": { ".validate": "newData.isString()" },
          "stopSequence": { ".validate": "newData.isNumber()" },
          "lat": { ".validate": "newData.isNumber()" },
          "lng": { ".validate": "newData.isNumber()" },
          "userName": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "deviceId": { ".validate": "newData.isString()" },
          "type": {
            ".validate": "newData.val() === 'BUS_AT_STOP' || newData.val() === 'ON_THE_BUS' || newData.val() === 'BUS_LEFT_STOP' || newData.val() === 'BUS_DELAYED' || newData.val() === 'BUS_CANCELLED' || newData.val() === 'EXTRA_BUS'"
          },
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() > (now - 300000) && newData.val() <= now"
          },
          "isActive": { ".validate": "newData.isBoolean()" },
          "confirmationCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "denialCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        }
      }
    },
    "live_locations": {
      "$routeId": {
        ".read": true,
        "$source": {
          ".write": "auth != null && ($source === 'DRIVER' || $source === 'TICKET_MACHINE')",
          ".validate": "newData.hasChildren(['routeId','lat','lng','timestamp','isActive','source'])",
          "routeId": { ".validate": "newData.isString() && newData.val().length > 0" },
          "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "lat": { ".validate": "newData.isNumber()" },
          "lng": { ".validate": "newData.isNumber()" },
          "speed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "bearing": { ".validate": "newData.isNumber()" },
          "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "reporterName": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "driverName": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "driverId": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "tripId": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "isActive": { ".validate": "newData.isBoolean()" },
          "source": {
            ".validate": "newData.val() === $source && (newData.val() === 'DRIVER' || newData.val() === 'TICKET_MACHINE')"
          },
          "$other": { ".validate": false }
        }
      }
    },
    "ticket_machine_sessions": {
      "$tripId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['routeId','tripId','machineId','verificationToken','qrPayload','lat','lng','createdAt','expiresAt','isActive'])",
        "routeId": { ".validate": "newData.isString() && newData.val().length > 0" },
        "tripId": { ".validate": "newData.isString() && newData.val() === $tripId" },
        "machineId": { ".validate": "newData.isString() && newData.val().length > 0" },
        "verificationToken": { ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 32" },
        "qrPayload": { ".validate": "newData.isString()" },
        "lat": { ".validate": "newData.isNumber()" },
        "lng": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "expiresAt": { ".validate": "newData.isNumber() && newData.val() > newData.parent().child('createdAt').val()" },
        "isActive": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "driver_verifications": {
      "$tripId": {
        "$driverId": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['routeId','tripId','driverId','machineId','status','verifiedAt'])",
          "routeId": { ".validate": "newData.isString()" },
          "tripId": { ".validate": "newData.isString() && newData.val() === $tripId" },
          "driverId": { ".validate": "newData.isString() && newData.val() === $driverId" },
          "machineId": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.val() === 'PENDING' || newData.val() === 'VERIFIED' || newData.val() === 'REJECTED' || newData.val() === 'EXPIRED'" },
          "distanceFromMachineMeters": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "verifiedAt": { ".validate": "newData.isNumber()" },
          "expiresAt": { ".validate": "newData.isNumber()" },
          "reason": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    },
    "alerts": {
      "$routeId": {
        ".read": true,
        ".write": false,
        ".indexOn": ["timestamp"]
      }
    }
  }
}
